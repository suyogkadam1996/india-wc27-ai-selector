# Data
# Raw downloaded match data: too large to store in git, and Cricsheet
# has its own usage terms for redistribution -- never committed.
data/raw/*
!data/raw/.gitkeep

# Processed data: the SMALL, useful result files (player/venue stats)
# ARE committed to git on purpose. This is what lets the automated
# monthly refresh (.github/workflows/refresh-data.yml) save fresh
# results back to the repo for you to use anytime, without needing to
# rerun anything yourself.
# We only exclude anything unexpectedly huge that might land here by mistake.
data/processed/*.json
!data/processed/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# MLflow
mlruns/

# Notebooks checkpoints
.ipynb_checkpoints/

# OS
.DS_Store

# Secrets - never commit these
.env
*.key
